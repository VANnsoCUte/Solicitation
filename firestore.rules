rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /solicitations/{id} {
      // Only signed-in admins can read or change records.
      // Use the same emails as adminEmails in firebase-config.js.
      allow read, write: if request.auth != null
        && request.auth.token.email in ["admin@example.com"];
    }
  }
}
